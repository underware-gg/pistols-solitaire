{
  "name": "@pistols-solitaire/client",
  "version": "0.1.0",
  "description": "Pistols Solitaire web client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --experimental-https",
    "dev:claude": "NEXT_DIST_DIR=.next-claude next dev --experimental-https --port 3009",
    "build": "next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "storybook dev -p 6006",
    "storybook:claude": "storybook dev -p 6009",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@cartridge/connector": "catalog:",
    "@cartridge/controller": "catalog:",
    "@dojoengine/core": "catalog:",
    "@dojoengine/torii-client": "catalog:",
    "@starknet-react/chains": "catalog:",
    "@starknet-react/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@underware/pistols-sdk": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "starknet": "catalog:",
    "tailwind-merge": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "catalog:",
    "@storybook/react": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
