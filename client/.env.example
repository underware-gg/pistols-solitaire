# Copy to .env.local. Values shown are the defaults.
# NEXT_PUBLIC_* is inlined at build time — restart the dev server after editing.

# --- Required ---
# None.

# --- Optional ---
# Active chain profile: mainnet (default) or sepolia. See client/src/dojo/profiles.ts.
# NEXT_PUBLIC_PROFILE=mainnet

# Per-profile URL overrides. Defaults shown are the mainnet profile's.
# NEXT_PUBLIC_RPC_URL=https://api.cartridge.gg/x/starknet/mainnet/rpc/v0_9
# NEXT_PUBLIC_TORII_URL=https://pistols-solitaire-mainnet.up.railway.app

# Build dir. `pnpm dev:claude` sets .next-claude to run a 2nd dev server.
# NEXT_DIST_DIR=.next
